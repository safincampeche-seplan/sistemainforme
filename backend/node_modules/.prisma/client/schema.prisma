generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Dependency {
  id                              BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  name                            String                            @db.VarChar(255)
  acronym                         String?                           @db.VarChar(50)
  is_trust                        Boolean                           @default(false)
  dependency_axis                 String?                           @db.VarChar(30)
  is_secretary                    Boolean                           @default(false)
  is_deconcentrated               Boolean                           @default(false)
  is_decentralized                Boolean                           @default(false)
  is_company                      Boolean                           @default(false)
  mission_id                      BigInt?                           @db.UnsignedBigInt
  sector_id                       BigInt?                           @db.UnsignedBigInt
  created_by                      BigInt?                           @db.UnsignedBigInt
  edited_by                       BigInt?                           @db.UnsignedBigInt
  deleted_at                      DateTime?                         @db.Timestamp(0)
  created_at                      DateTime?                         @db.Timestamp(0)
  updated_at                      DateTime?                         @db.Timestamp(0)
  cat_missions                    Mission?                          @relation(fields: [mission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cat_dependencies_mission_id_foreign")
  cat_sectors                     cat_sectors?                      @relation(fields: [sector_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cat_dependencies_sector_id_foreign")
  catalogs                        catalogs[]
  entities                        Entity[]
  entities_first_final            entities_first_final[]
  entities_second_final           entities_second_final[]
  captures                        NarrativeCapture[]
  narrative_captures_first_final  narrative_captures_first_final[]
  narrative_captures_second_final narrative_captures_second_final[]
  users                           User[]

  @@index([mission_id], map: "cat_dependencies_mission_id_foreign")
  @@index([sector_id], map: "cat_dependencies_sector_id_foreign")
  @@map("cat_dependencies")
}

model Mission {
  id                                       BigInt                                     @id @default(autoincrement()) @db.UnsignedBigInt
  name                                     String                                     @db.VarChar(255)
  code                                     Int
  narrative_period_id                      BigInt                                     @db.UnsignedBigInt
  title_color                              String?                                    @db.VarChar(6)
  theme_color                              String?                                    @db.VarChar(6)
  subtheme_color                           String?                                    @db.VarChar(6)
  created_by                               BigInt?                                    @db.UnsignedBigInt
  edited_by                                BigInt?                                    @db.UnsignedBigInt
  deleted_at                               DateTime?                                  @db.Timestamp(0)
  created_at                               DateTime?                                  @db.Timestamp(0)
  updated_at                               DateTime?                                  @db.Timestamp(0)
  cat_dependencies                         Dependency[]
  cat_narrative_periods                    cat_narrative_periods                      @relation(fields: [narrative_period_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cat_missions_narrative_period_id_foreign")
  cat_narrative_titles                     NarrativeTitle[]
  cat_objectives                           cat_objectives[]
  miss_obj_stra_act_narrative              miss_obj_stra_act_narrative[]
  miss_obj_stra_act_narrative_first_final  miss_obj_stra_act_narrative_first_final[]
  miss_obj_stra_act_narrative_second_final miss_obj_stra_act_narrative_second_final[]

  @@index([narrative_period_id], map: "cat_missions_narrative_period_id_foreign")
  @@map("cat_missions")
}

model NarrativeCapture {
  id                                         BigInt                               @id @default(autoincrement()) @db.UnsignedBigInt
  sequence_number                            String                               @db.VarChar(255)
  narrative_period_id                        BigInt                               @db.UnsignedBigInt
  dependency_id                              BigInt?                              @db.UnsignedBigInt
  narrative_title_id                         BigInt?                              @db.UnsignedBigInt
  narrative_theme_id                         BigInt?                              @db.UnsignedBigInt
  narrative_sub_theme_id                     BigInt?                              @db.UnsignedBigInt
  order                                      Int?
  ppa_name                                   String                               @db.VarChar(255)
  new_ppa_name                               String?                              @db.VarChar(255)
  ppas_type_id                               BigInt?                              @db.UnsignedBigInt
  investment_amount                          Decimal?                             @db.Decimal(15, 2)
  beneficiaries                              Int?
  narrative_beneficiary_type_id              BigInt?                              @db.UnsignedBigInt
  budget_program_id                          BigInt?                              @db.UnsignedBigInt
  locations                                  Json?
  peds                                       Json?
  status                                     narrative_captures_status            @default(historical__in_capture_)
  observations                               String?                              @db.Text
  narrative_breakdown                        String                               @db.LongText
  highlighted                                String?                              @db.LongText
  stage                                      Int?                                 @default(1)
  created_by                                 BigInt?                              @db.UnsignedBigInt
  edited_by                                  BigInt?                              @db.UnsignedBigInt
  deleted_at                                 DateTime?                            @db.Timestamp(0)
  created_at                                 DateTime?                            @db.Timestamp(0)
  updated_at                                 DateTime?                            @updatedAt @db.Timestamp(0)
  custom_budget_program                      String?                              @db.VarChar(255)
  entity_linkage_narrative                   entity_linkage_narrative[]
  miss_obj_stra_act_narrative                miss_obj_stra_act_narrative[]
  municipality_locality_narrative            municipality_locality_narrative[]
  narrative_capture_status_histories         narrative_capture_status_histories[]
  budget_program                             BudgetProgram?                       @relation(fields: [budget_program_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "narrative_captures_budget_program_id_foreign")
  users_narrative_captures_created_byTousers User?                                @relation("narrative_captures_created_byTousers", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "narrative_captures_created_by_foreign")
  dependency                                 Dependency?                          @relation(fields: [dependency_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "narrative_captures_dependency_id_foreign")
  users_narrative_captures_edited_byTousers  User?                                @relation("narrative_captures_edited_byTousers", fields: [edited_by], references: [id], onUpdate: NoAction, map: "narrative_captures_edited_by_foreign")
  cat_narrative_beneficiary_types            cat_narrative_beneficiary_types?     @relation(fields: [narrative_beneficiary_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "narrative_captures_narrative_beneficiary_type_id_foreign")
  cat_narrative_periods                      cat_narrative_periods                @relation(fields: [narrative_period_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "narrative_captures_narrative_period_id_foreign")
  cat_narrative_sub_themes                   cat_narrative_sub_themes?            @relation(fields: [narrative_sub_theme_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "narrative_captures_narrative_sub_theme_id_foreign")
  cat_narrative_themes                       NarrativeTheme?                      @relation(fields: [narrative_theme_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "narrative_captures_narrative_theme_id_foreign")
  cat_narrative_titles                       NarrativeTitle?                      @relation(fields: [narrative_title_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "narrative_captures_narrative_title_id_foreign")
  cat_ppas_types                             cat_ppas_types?                      @relation(fields: [ppas_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "narrative_captures_ppas_type_id_foreign")
  ods_linkage_narrative                      ods_linkage_narrative[]

  @@unique([sequence_number, narrative_period_id], map: "sequence_period_unique")
  @@index([budget_program_id], map: "narrative_captures_budget_program_id_foreign")
  @@index([created_by], map: "narrative_captures_created_by_foreign")
  @@index([dependency_id], map: "narrative_captures_dependency_id_foreign")
  @@index([edited_by], map: "narrative_captures_edited_by_foreign")
  @@index([narrative_beneficiary_type_id], map: "narrative_captures_narrative_beneficiary_type_id_foreign")
  @@index([narrative_period_id], map: "narrative_captures_narrative_period_id_foreign")
  @@index([narrative_sub_theme_id], map: "narrative_captures_narrative_sub_theme_id_foreign")
  @@index([narrative_theme_id], map: "narrative_captures_narrative_theme_id_foreign")
  @@index([narrative_title_id], map: "narrative_captures_narrative_title_id_foreign")
  @@index([ppas_type_id], map: "narrative_captures_ppas_type_id_foreign")
  @@map("narrative_captures")
}

model NarrativeTitle {
  id                              BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  name                            String                            @db.VarChar(255)
  code                            Int
  mission_id                      BigInt?                           @db.UnsignedBigInt
  created_by                      BigInt?                           @db.UnsignedBigInt
  edited_by                       BigInt?                           @db.UnsignedBigInt
  deleted_at                      DateTime?                         @db.Timestamp(0)
  created_at                      DateTime?                         @db.Timestamp(0)
  updated_at                      DateTime?                         @db.Timestamp(0)
  themes                          NarrativeTheme[]
  cat_missions                    Mission?                          @relation(fields: [mission_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cat_narrative_titles_mission_id_foreign")
  narrative_captures              NarrativeCapture[]
  narrative_captures_first_final  narrative_captures_first_final[]
  narrative_captures_second_final narrative_captures_second_final[]

  @@index([mission_id], map: "cat_narrative_titles_mission_id_foreign")
  @@map("cat_narrative_titles")
}

model NarrativeTheme {
  id                              BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  name                            String?                           @db.VarChar(255)
  code                            Int?
  narrative_title_id              BigInt                            @db.UnsignedBigInt
  created_by                      BigInt?                           @db.UnsignedBigInt
  edited_by                       BigInt?                           @db.UnsignedBigInt
  deleted_at                      DateTime?                         @db.Timestamp(0)
  created_at                      DateTime?                         @db.Timestamp(0)
  updated_at                      DateTime?                         @db.Timestamp(0)
  cat_narrative_sub_themes        cat_narrative_sub_themes[]
  title                           NarrativeTitle                    @relation(fields: [narrative_title_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cat_narrative_themes_narrative_title_id_foreign")
  narrative_captures              NarrativeCapture[]
  narrative_captures_first_final  narrative_captures_first_final[]
  narrative_captures_second_final narrative_captures_second_final[]

  @@index([narrative_title_id], map: "cat_narrative_themes_narrative_title_id_foreign")
  @@map("cat_narrative_themes")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model NarrativeFinancingSource {
  id     Int?
  name   String? @db.VarChar(255)
  activo Int?

  @@map("cat_financing_sources")
  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model NarrativeBeneficiaryType {
  id     Int?
  name   String? @db.VarChar(255)
  activo Int?

  @@map("cat_beneficiary_types")
  @@ignore
}

model BudgetProgram {
  id                              BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  name                            String                            @db.VarChar(255)
  code                            Int
  type                            String                            @db.VarChar(255)
  created_by                      BigInt?                           @db.UnsignedBigInt
  edited_by                       BigInt?                           @db.UnsignedBigInt
  deleted_at                      DateTime?                         @db.Timestamp(0)
  created_at                      DateTime?                         @db.Timestamp(0)
  updated_at                      DateTime?                         @db.Timestamp(0)
  captures                        NarrativeCapture[]
  narrative_captures_first_final  narrative_captures_first_final[]
  narrative_captures_second_final narrative_captures_second_final[]

  @@map("cat_budget_programs")
}

model OdsLinkage {
  id                                 BigInt                               @id @default(autoincrement()) @db.UnsignedBigInt
  name                               String                               @db.VarChar(255)
  code                               Int
  deleted_at                         DateTime?                            @db.Timestamp(0)
  created_at                         DateTime?                            @db.Timestamp(0)
  updated_at                         DateTime?                            @db.Timestamp(0)
  ods_linkage_narrative              ods_linkage_narrative[]
  ods_linkage_narrative_first_final  ods_linkage_narrative_first_final[]
  ods_linkage_narrative_second_final ods_linkage_narrative_second_final[]

  @@map("cat_ods_linkages")
}

model Entity {
  id                               BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  name                             String                     @db.VarChar(255)
  is_financial                     Boolean                    @default(false)
  dependency_id                    BigInt                     @db.UnsignedBigInt
  status                           String                     @default("draft") @db.VarChar(20)
  source                           String?                    @db.Text
  notes                            String?                    @db.Text
  second_stage                     Boolean                    @default(false)
  format_type_id                   BigInt?                    @db.UnsignedBigInt
  stage                            Int?                       @default(1)
  period_id                        Int?                       @default(1)
  created_by                       BigInt?                    @db.UnsignedBigInt
  edited_by                        BigInt?                    @db.UnsignedBigInt
  deleted_at                       DateTime?                  @db.Timestamp(0)
  created_at                       DateTime?                  @db.Timestamp(0)
  updated_at                       DateTime?                  @db.Timestamp(0)
  users_entities_created_byTousers User?                      @relation("entities_created_byTousers", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "entities_created_by_foreign")
  dependency                       Dependency                 @relation(fields: [dependency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "entities_dependency_id_foreign")
  users_entities_edited_byTousers  User?                      @relation("entities_edited_byTousers", fields: [edited_by], references: [id], onUpdate: NoAction, map: "entities_edited_by_foreign")
  cat_format_types                 cat_format_types?          @relation(fields: [format_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "entities_format_type_id_foreign")
  entity_linkage_narrative         entity_linkage_narrative[]
  entity_status_histories          entity_status_histories[]
  entries                          Entry[]
  properties                       Property[]

  @@index([created_by], map: "entities_created_by_foreign")
  @@index([dependency_id], map: "entities_dependency_id_foreign")
  @@index([edited_by], map: "entities_edited_by_foreign")
  @@index([format_type_id], map: "entities_format_type_id_foreign")
  @@map("entities")
}

model Property {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  entity_id     BigInt    @db.UnsignedBigInt
  column_name   String    @db.VarChar(200)
  column_type   String    @db.VarChar(30)
  catalog_id    BigInt?   @db.UnsignedBigInt
  is_required   Boolean   @default(false)
  is_additional Boolean   @default(false)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  deleted_at    DateTime? @db.Timestamp(0)
  created_by    BigInt?   @db.UnsignedBigInt
  edited_by     BigInt?   @db.UnsignedBigInt
  catalogs      catalogs? @relation(fields: [catalog_id], references: [id], onUpdate: NoAction, map: "properties_catalog_id_foreign")
  entity        Entity    @relation(fields: [entity_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "properties_entity_id_foreign")
  values        Value[]

  @@index([catalog_id], map: "properties_catalog_id_foreign")
  @@index([entity_id], map: "properties_entity_id_foreign")
  @@map("properties")
}

model Entry {
  id                              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  entity_id                       BigInt       @db.UnsignedBigInt
  period_id                       BigInt?      @db.UnsignedBigInt
  created_by                      BigInt?      @db.UnsignedBigInt
  edited_by                       BigInt?      @db.UnsignedBigInt
  deleted_at                      DateTime?    @db.Timestamp(0)
  created_at                      DateTime?    @db.Timestamp(0)
  updated_at                      DateTime?    @db.Timestamp(0)
  users_entries_created_byTousers User?        @relation("entries_created_byTousers", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "entries_created_by_foreign")
  users_entries_edited_byTousers  User?        @relation("entries_edited_byTousers", fields: [edited_by], references: [id], onUpdate: NoAction, map: "entries_edited_by_foreign")
  entity                          Entity       @relation(fields: [entity_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "entries_entity_id_foreign")
  cat_periods                     cat_periods? @relation(fields: [period_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "entries_period_id_foreign")
  values                          Value[]

  @@index([created_by], map: "entries_created_by_foreign")
  @@index([edited_by], map: "entries_edited_by_foreign")
  @@index([entity_id], map: "entries_entity_id_foreign")
  @@index([period_id], map: "entries_period_id_foreign")
  @@map("entries")
}

model Value {
  id                             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  entry_id                       BigInt    @db.UnsignedBigInt
  property_id                    BigInt    @db.UnsignedBigInt
  value                          String?   @db.Text
  created_by                     BigInt?   @db.UnsignedBigInt
  edited_by                      BigInt?   @db.UnsignedBigInt
  deleted_at                     DateTime? @db.Timestamp(0)
  created_at                     DateTime? @db.Timestamp(0)
  updated_at                     DateTime? @db.Timestamp(0)
  users_values_created_byTousers User?     @relation("values_created_byTousers", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "values_created_by_foreign")
  users_values_edited_byTousers  User?     @relation("values_edited_byTousers", fields: [edited_by], references: [id], onUpdate: NoAction, map: "values_edited_by_foreign")
  entry                          Entry     @relation(fields: [entry_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "values_entry_id_foreign")
  properties                     Property  @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "values_property_id_foreign")

  @@index([created_by], map: "values_created_by_foreign")
  @@index([edited_by], map: "values_edited_by_foreign")
  @@index([entry_id], map: "values_entry_id_foreign")
  @@index([property_id], map: "values_property_id_foreign")
  @@map("values")
}

model User {
  id                                                                                BigInt                               @id @default(autoincrement()) @db.UnsignedBigInt
  name                                                                              String                               @db.VarChar(255)
  last_name                                                                         String?                              @db.VarChar(255)
  second_lastname                                                                   String?                              @db.VarChar(255)
  is_active                                                                         Boolean                              @default(true)
  created_by                                                                        BigInt?                              @db.UnsignedBigInt
  edited_by                                                                         BigInt?                              @db.UnsignedBigInt
  email                                                                             String                               @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at                                                                 DateTime?                            @db.Timestamp(0)
  password                                                                          String                               @db.VarChar(255)
  remember_token                                                                    String?                              @db.VarChar(100)
  created_at                                                                        DateTime?                            @db.Timestamp(0)
  updated_at                                                                        DateTime?                            @db.Timestamp(0)
  dependency_id                                                                     BigInt?                              @db.UnsignedBigInt
  profile_id                                                                        BigInt?                              @db.UnsignedBigInt
  deleted_at                                                                        DateTime?                            @db.Timestamp(0)
  cat_periods_cat_periods_created_byTousers                                         cat_periods[]                        @relation("cat_periods_created_byTousers")
  cat_periods_cat_periods_edited_byTousers                                          cat_periods[]                        @relation("cat_periods_edited_byTousers")
  entities_entities_created_byTousers                                               Entity[]                             @relation("entities_created_byTousers")
  entities_entities_edited_byTousers                                                Entity[]                             @relation("entities_edited_byTousers")
  entities_first_final_entities_first_final_created_byTousers                       entities_first_final[]               @relation("entities_first_final_created_byTousers")
  entities_first_final_entities_first_final_edited_byTousers                        entities_first_final[]               @relation("entities_first_final_edited_byTousers")
  entities_second_final_entities_second_final_created_byTousers                     entities_second_final[]              @relation("entities_second_final_created_byTousers")
  entities_second_final_entities_second_final_edited_byTousers                      entities_second_final[]              @relation("entities_second_final_edited_byTousers")
  entity_status_histories                                                           entity_status_histories[]
  entries_entries_created_byTousers                                                 Entry[]                              @relation("entries_created_byTousers")
  entries_entries_edited_byTousers                                                  Entry[]                              @relation("entries_edited_byTousers")
  entries_first_final_entries_first_final_created_byTousers                         entries_first_final[]                @relation("entries_first_final_created_byTousers")
  entries_first_final_entries_first_final_edited_byTousers                          entries_first_final[]                @relation("entries_first_final_edited_byTousers")
  entries_second_final_entries_second_final_created_byTousers                       entries_second_final[]               @relation("entries_second_final_created_byTousers")
  entries_second_final_entries_second_final_edited_byTousers                        entries_second_final[]               @relation("entries_second_final_edited_byTousers")
  exports                                                                           exports[]
  imports                                                                           imports[]
  narrative_capture_status_histories                                                narrative_capture_status_histories[]
  narrative_captures_narrative_captures_created_byTousers                           NarrativeCapture[]                   @relation("narrative_captures_created_byTousers")
  narrative_captures_narrative_captures_edited_byTousers                            NarrativeCapture[]                   @relation("narrative_captures_edited_byTousers")
  narrative_captures_first_final_narrative_captures_first_final_created_byTousers   narrative_captures_first_final[]     @relation("narrative_captures_first_final_created_byTousers")
  narrative_captures_first_final_narrative_captures_first_final_edited_byTousers    narrative_captures_first_final[]     @relation("narrative_captures_first_final_edited_byTousers")
  narrative_captures_second_final_narrative_captures_second_final_created_byTousers narrative_captures_second_final[]    @relation("narrative_captures_second_final_created_byTousers")
  narrative_captures_second_final_narrative_captures_second_final_edited_byTousers  narrative_captures_second_final[]    @relation("narrative_captures_second_final_edited_byTousers")
  users_users_created_byTousers                                                     User?                                @relation("users_created_byTousers", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "users_created_by_foreign")
  other_users_users_created_byTousers                                               User[]                               @relation("users_created_byTousers")
  dependency                                                                        Dependency?                          @relation(fields: [dependency_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "users_dependency_id_foreign")
  users_users_edited_byTousers                                                      User?                                @relation("users_edited_byTousers", fields: [edited_by], references: [id], onUpdate: Restrict, map: "users_edited_by_foreign")
  other_users_users_edited_byTousers                                                User[]                               @relation("users_edited_byTousers")
  cat_profiles                                                                      cat_profiles?                        @relation(fields: [profile_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "users_profile_id_foreign")
  values_values_created_byTousers                                                   Value[]                              @relation("values_created_byTousers")
  values_values_edited_byTousers                                                    Value[]                              @relation("values_edited_byTousers")
  values_first_final_values_first_final_created_byTousers                           values_first_final[]                 @relation("values_first_final_created_byTousers")
  values_first_final_values_first_final_edited_byTousers                            values_first_final[]                 @relation("values_first_final_edited_byTousers")
  values_second_final_values_second_final_created_byTousers                         values_second_final[]                @relation("values_second_final_created_byTousers")
  values_second_final_values_second_final_edited_byTousers                          values_second_final[]                @relation("values_second_final_edited_byTousers")

  @@index([created_by], map: "users_created_by_foreign")
  @@index([dependency_id], map: "users_dependency_id_foreign")
  @@index([edited_by], map: "users_edited_by_foreign")
  @@index([profile_id], map: "users_profile_id_foreign")
  @@map("users")
}

model Role {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String                 @db.VarChar(255)
  guard_name           String                 @db.VarChar(255)
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  users                UserHasRole[]
  role_has_permissions role_has_permissions[]

  @@unique([name, guard_name], map: "roles_name_guard_name_unique")
  @@map("roles")
}

model UserHasRole {
  role_id    BigInt @db.UnsignedBigInt
  model_type String @db.VarChar(255)
  model_id   BigInt @db.UnsignedBigInt
  role       Role   @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "model_has_roles_role_id_foreign")

  @@id([role_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_roles_model_id_model_type_index")
  @@map("model_has_roles")
}

model activity_log {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  log_name         String?   @db.VarChar(255)
  description      String    @db.Text
  subject_type     String?   @db.VarChar(255)
  event            String?   @db.VarChar(255)
  subject_id       BigInt?   @db.UnsignedBigInt
  causer_type      String?   @db.VarChar(255)
  causer_id        BigInt?   @db.UnsignedBigInt
  properties       Json?
  batch_uuid       String?   @db.Char(36)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  equipment_origin String?   @db.VarChar(100)
  user_agent       String?   @db.Text

  @@index([log_name], map: "activity_log_log_name_index")
  @@index([causer_type, causer_id], map: "causer")
  @@index([subject_type, subject_id], map: "subject")
}


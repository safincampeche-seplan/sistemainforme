model properties_first_final {
  id                   BigInt               @id @db.UnsignedBigInt
  entity_id            BigInt               @db.UnsignedBigInt
  column_name          String               @db.VarChar(200)
  column_type          String               @db.VarChar(30)
  catalog_id           BigInt?              @db.UnsignedBigInt
  is_required          Boolean              @default(false)
  is_additional        Boolean              @default(false)
  period_id            BigInt?              @db.UnsignedBigInt
  created_at           DateTime?            @db.Timestamp(0)
  updated_at           DateTime?            @db.Timestamp(0)
  catalogs             catalogs?            @relation(fields: [catalog_id], references: [id], onUpdate: Restrict, map: "properties_catalog_id_foreign_1f")
  entities_first_final entities_first_final @relation(fields: [entity_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "properties_entity_id_foreign_1f")
  values_first_final   values_first_final[]

  @@index([catalog_id], map: "properties_catalog_id_foreign")
  @@index([entity_id], map: "properties_entity_id_foreign")
}

model properties_second_final {
  id                    BigInt                @id @db.UnsignedBigInt
  entity_id             BigInt                @db.UnsignedBigInt
  column_name           String                @db.VarChar(200)
  column_type           String                @db.VarChar(30)
  catalog_id            BigInt?               @db.UnsignedBigInt
  is_required           Boolean               @default(false)
  is_additional         Boolean               @default(false)
  period_id             BigInt?               @db.UnsignedBigInt
  created_at            DateTime?             @db.Timestamp(0)
  updated_at            DateTime?             @db.Timestamp(0)
  catalogs              catalogs?             @relation(fields: [catalog_id], references: [id], onUpdate: Restrict, map: "properties_catalog_id_foreign_2f")
  entities_second_final entities_second_final @relation(fields: [entity_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "properties_entity_id_foreign_2f")
  values_second_final   values_second_final[]

  @@index([catalog_id], map: "properties_catalog_id_foreign")
  @@index([entity_id], map: "properties_entity_id_foreign")
}

model role_has_permissions {
  permission_id BigInt      @db.UnsignedBigInt
  role_id       BigInt      @db.UnsignedBigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "role_has_permissions_permission_id_foreign")
  roles         Role        @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "role_has_permissions_role_id_foreign")

  @@id([permission_id, role_id])
  @@index([role_id], map: "role_has_permissions_role_id_foreign")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model values_first_final {
  id                                         BigInt                 @id @db.UnsignedBigInt
  entry_id                                   BigInt                 @db.UnsignedBigInt
  property_id                                BigInt                 @db.UnsignedBigInt
  value                                      String?                @db.Text
  stage                                      Int?
  period_id                                  BigInt?                @db.UnsignedBigInt
  created_by                                 BigInt?                @db.UnsignedBigInt
  edited_by                                  BigInt?                @db.UnsignedBigInt
  created_at                                 DateTime?              @db.Timestamp(0)
  updated_at                                 DateTime?              @db.Timestamp(0)
  users_values_first_final_created_byTousers User?                  @relation("values_first_final_created_byTousers", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "values_created_by_foreign_1f")
  users_values_first_final_edited_byTousers  User?                  @relation("values_first_final_edited_byTousers", fields: [edited_by], references: [id], onUpdate: Restrict, map: "values_edited_by_foreign_1f")
  entries_first_final                        entries_first_final    @relation(fields: [entry_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "values_entry_id_foreign_1f")
  properties_first_final                     properties_first_final @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "values_property_id_foreign_1f")

  @@index([created_by], map: "values_created_by_foreign")
  @@index([edited_by], map: "values_edited_by_foreign")
  @@index([entry_id], map: "values_entry_id_foreign")
  @@index([property_id], map: "values_property_id_foreign")
}

model values_second_final {
  id                                          BigInt                  @id @db.UnsignedBigInt
  entry_id                                    BigInt                  @db.UnsignedBigInt
  property_id                                 BigInt                  @db.UnsignedBigInt
  value                                       String?                 @db.Text
  stage                                       Int?
  period_id                                   BigInt?                 @db.UnsignedBigInt
  created_by                                  BigInt?                 @db.UnsignedBigInt
  edited_by                                   BigInt?                 @db.UnsignedBigInt
  created_at                                  DateTime?               @db.Timestamp(0)
  updated_at                                  DateTime?               @db.Timestamp(0)
  users_values_second_final_created_byTousers User?                   @relation("values_second_final_created_byTousers", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "values_created_by_foreign_2f")
  users_values_second_final_edited_byTousers  User?                   @relation("values_second_final_edited_byTousers", fields: [edited_by], references: [id], onUpdate: Restrict, map: "values_edited_by_foreign_2f")
  entries_first_final                         entries_first_final     @relation(fields: [entry_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "values_entry_id_foreign_2f")
  properties_second_final                     properties_second_final @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "values_property_id_foreign_2f")

  @@index([created_by], map: "values_created_by_foreign")
  @@index([edited_by], map: "values_edited_by_foreign")
  @@index([entry_id], map: "values_entry_id_foreign")
  @@index([property_id], map: "values_property_id_foreign")
}

enum catalogs_type {
  general_catalog
  specific_catalog
}

